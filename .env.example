# Site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://soccer.co.ke

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional — TheSportsDB (Kenya KPL fixtures/results). Free public key is 123.
# Do not use key 3 — it returns 403. Paid keys: https://www.thesportsdb.com/
THESPORTSDB_API_KEY=123

# Optional — Premier League tables from football-data.org
# Free key: https://www.football-data.org/client/register
# Not required for fixtures/results (FotMob is used as fallback).
FOOTBALL_DATA_API_KEY=

# Optional — extra headlines enrichment (RSS still works without this)
# Free key: https://gnews.io/register
# Free plans rate-limit quickly; the site pauses GNews on 429 and keeps RSS.
GNEWS_API_KEY=

# Autopilot cron — protect /api/cron/refresh (required on production)
# Generate any long random string. Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional — Coach Bolt AI
# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
