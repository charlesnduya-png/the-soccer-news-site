# Public site URL used for canonical links and sharing metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional analytics
NEXT_PUBLIC_GA_ID=G-CLP63EV54W
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional APIs; RSS, YouTube and Google News RSS work without keys
GNEWS_API_KEY=
FOOTBALL_DATA_API_KEY=

# Required for authenticated background refresh jobs
# Generate a long random value and use the same value in your host's cron job
CRON_SECRET=replace-with-a-long-random-secret
# Site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://soccer.co.ke

# Optional analytics
NEXT_PUBLIC_GA_ID=

# Optional — live Premier League tables & scores
# Free key: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Optional — extra headlines (RSS still works without this)
# Free key: https://gnews.io/register
GNEWS_API_KEY=

# Autopilot cron — protect /api/cron/refresh (required on production)
# Generate any long random string. Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional — Coach Bolt AI (same keys as coach-bolt.vercel.app)
# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
