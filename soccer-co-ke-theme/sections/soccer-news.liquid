{%- if section.settings.api_base_url != blank -%}
  {%- assign api_base = section.settings.api_base_url -%}
{%- else -%}
  {%- assign api_base = settings.api_base_url | default: 'https://soccercoke-alpha.vercel.app' -%}
{%- endif -%}

<section
  class="soccer-hub-block page-width"
  data-soccer-news
  data-api-base="{{ api_base }}"
  data-limit="{{ section.settings.article_limit | default: 12 }}"
  id="soccer-news-{{ section.id }}"
>
  <div class="soccer-section-head">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <p class="soccer-status" data-soccer-news-status>Connecting to news APIs…</p>
    </div>
  </div>
  <div data-soccer-news-grid>
    <div class="soccer-news-grid">
      {% for i in (1..6) %}
        <div class="soccer-news-card" style="pointer-events:none;opacity:0.5;">
          <div class="soccer-news-card__media"></div>
          <div class="soccer-news-card__body">
            <span class="soccer-news-card__source">Loading</span>
            <h3>Fetching latest football news…</h3>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{{ 'soccer-hub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'soccer-hub.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Soccer News (Live API)",
  "tag": "section",
  "class": "section-soccer-news",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Football News"
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "News API base URL",
      "info": "Default: https://soccercoke-alpha.vercel.app — powers BBC, Guardian, ESPN & GNews"
    },
    {
      "type": "range",
      "id": "article_limit",
      "min": 6,
      "max": 24,
      "step": 2,
      "label": "Articles to show",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Soccer News (Live API)"
    }
  ]
}
{% endschema %}
