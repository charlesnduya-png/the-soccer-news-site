<div class="page-width page-content">
  <h1>{{ collection.title }}</h1>
  {% if collection.description != blank %}
    <div class="rte">{{ collection.description }}</div>
  {% endif %}

  {% if collection.products.size > 0 %}
    <div class="product-grid">
      {% for product in collection.products %}
        <article class="product-card">
          <a href="{{ product.url }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 600 | image_tag: class: 'product-card__image', loading: 'lazy', alt: product.title }}
            {% endif %}
          </a>
          <div class="product-card__info">
            <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="product-card__price">{{ product.price | money }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p>{{ 'collections.general.no_matches' | t }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "section-main-collection",
  "settings": []
}
{% endschema %}
