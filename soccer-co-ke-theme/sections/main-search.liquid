<div class="page-width page-content">
  <h1>{{ 'general.search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="margin-bottom:2rem;">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" style="padding:0.75rem 1rem;width:100%;max-width:400px;border:1px solid #ddd;border-radius:999px;">
    <button type="submit" class="product-page__btn" style="margin-left:0.5rem;">{{ 'general.search.submit' | t }}</button>
  </form>

  {% if search.performed %}
    {% if search.results.size > 0 %}
      <div class="product-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            <article class="product-card">
              <a href="{{ item.url }}">
                {% if item.featured_image %}
                  {{ item.featured_image | image_url: width: 600 | image_tag: class: 'product-card__image', loading: 'lazy', alt: item.title }}
                {% endif %}
              </a>
              <div class="product-card__info">
                <h3 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                <p class="product-card__price">{{ item.price | money }}</p>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p>{{ 'general.search.no_results' | t }}</p>
    {% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
