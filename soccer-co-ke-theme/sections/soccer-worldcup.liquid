<section
  class="soccer-hub-block soccer-hub-block--dark page-width"
  data-soccer-worldcup
  data-mode="{{ section.settings.display_mode | default: 'preview' }}"
  id="soccer-wc-{{ section.id }}"
>
  <div class="soccer-section-head">
    <div>
      <span class="soccer-badge soccer-badge--live">World Cup 2026</span>
      <h2>{{ section.settings.heading }}</h2>
      <p class="soccer-status" data-soccer-wc-status>Connecting to worldcup26.ir…</p>
    </div>
  </div>

  <div class="soccer-matches-grid" data-soccer-wc-matches></div>
  <div data-soccer-wc-groups></div>
</section>

{{ 'soccer-hub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'soccer-hub.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "World Cup Live Scores",
  "tag": "section",
  "class": "section-soccer-worldcup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Live Scores & Matches"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        { "value": "preview", "label": "Preview (matches only)" },
        { "value": "full", "label": "Full (matches + group tables)" }
      ],
      "default": "preview"
    }
  ],
  "presets": [
    {
      "name": "World Cup Live Scores"
    }
  ]
}
{% endschema %}
