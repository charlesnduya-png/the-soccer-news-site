{%- assign news_handle = settings.news_page_handle | default: 'news' -%}
{%- assign wc_handle = settings.worldcup_page_handle | default: 'world-cup' -%}

<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__title">Football Hub</p>
        <a href="/pages/{{ wc_handle }}" class="site-footer__link">World Cup 2026 Live</a>
        <a href="/pages/{{ news_handle }}" class="site-footer__link">Latest News</a>
      </div>
      <div>
        <p class="site-footer__title">Shop</p>
        <a href="{{ routes.all_products_collection_url }}" class="site-footer__link">All Products</a>
        <a href="{{ routes.cart_url }}" class="site-footer__link">Cart</a>
      </div>
      <div>
        <p class="site-footer__title">{{ shop.name }}</p>
        <p style="font-size:0.875rem;margin:0;">Live scores & news powered by free APIs</p>
      </div>
    </div>
    <div class="site-footer__bottom">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · News via soccercoke-alpha.vercel.app · Scores via worldcup26.ir
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": []
}
{% endschema %}
