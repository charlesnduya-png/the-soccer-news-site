<div class="page-width page-content">
  <article>
    <h1>{{ article.title }}</h1>
    <p style="color:#666;font-size:0.875rem;margin-bottom:1.5rem;">{{ article.published_at | date: '%B %d, %Y' }}</p>
    <div class="rte">{{ article.content }}</div>
  </article>
</div>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
