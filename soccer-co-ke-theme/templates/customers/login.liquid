{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="password-page">
    <main class="page-width password-content" style="padding:4rem 0;text-align:center;">
      <h1>{{ shop.name }}</h1>
      <p>{{ 'general.password_page.opening_soon' | t }}</p>
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <label for="Password">{{ 'general.password_page.login_form_password' | t }}</label>
        <input type="password" name="password" id="Password" autocomplete="current-password" style="padding:0.5rem 1rem;margin:0.5rem;border:1px solid #ddd;border-radius:8px;">
        <button type="submit" class="product-page__btn">{{ 'general.password_page.login_form_submit' | t }}</button>
      {% endform %}
    </main>
  </body>
</html>
