{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_initial_value, shop: shop.name }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body style="text-align:center;padding:3rem 1rem;">
    <h1 style="color:#37003c;">{{ shop.name }}</h1>
    <p>Gift card: {{ gift_card.balance | money }}</p>
    <p style="font-size:1.5rem;font-weight:700;letter-spacing:0.1em;">{{ gift_card.code | format_code }}</p>
    {% if gift_card.pass_url %}
      <a href="{{ gift_card.pass_url }}" class="product-page__btn" style="text-decoration:none;display:inline-block;">Add to Apple Wallet</a>
    {% endif %}
  </body>
</html>
